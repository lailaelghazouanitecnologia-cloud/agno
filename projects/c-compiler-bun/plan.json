        },
        {
          "path": "tests/fixtures/factorial.c",
          "description": "Factorial test fixture"
        },
        {
          "path": "tests/fixtures/fibonacci.c",
          "description": "Fibonacci test fixture"
        },
        {
          "path": "tests/fixtures/arrays.c",
          "description": "Array operations test fixture"
        },
        {
          "path": "tests/fixtures/pointers.c",
          "description": "Pointer operations test fixture"
        },
        {
          "path": "tests/fixtures/loops.c",
          "description": "Loop constructs test fixture"
        },
        {
          "path": "tests/fixtures/functions.c",
          "description": "Function operations test fixture"
        },
        {
          "path": "tests/fixtures/io.c",
          "description": "I/O operations test fixture"
        },
        {
          "path": "tests/fixtures/complex.c",
          "description": "Complex program test fixture"
        }
      ],
      "dependencies": ["all-modules"]
    },
    {
      "id": "config",
      "name": "Configuration",
      "description": "Project configuration files",
      "files": [
        {
          "path": "package.json",
          "description": "Bun package configuration",
          "content": {
            "name": "c-compiler-bun",
            "version": "1.0.0",
            "description": "A C compiler in TypeScript using Bun with micro-VM architecture",
            "type": "module",
            "main": "dist/cli/index.js",
            "bin": {
              "cc-bun": "./dist/cli/index.js"
            },
            "scripts": {
              "build": "bun build src/cli/index.ts --outdir dist --target bun",
              "dev": "bun run src/cli/index.ts",
              "test": "bun test",
              "lint": "bunx eslint src",
              "format": "bunx prettier --write src"
            },
            "devDependencies": {
              "bun-types": "latest",
              "@types/bun": "latest"
            },
            "engines": {
              "bun": ">=1.0.0"
            }
          }
        },
        {
          "path": "tsconfig.json",
          "description": "TypeScript configuration",
          "content": {
            "compilerOptions": {
              "target": "ESNext",
              "module": "ESNext",
              "moduleResolution": "bundler",
              "lib": ["ESNext"],
              "strict": true,
              "esModuleInterop": true,
              "skipLibCheck": true,
              "forceConsistentCasingInFileNames": true,
              "resolveJsonModule": true,
              "allowSyntheticDefaultImports": true,
              "declaration": true,
              "declarationMap": true,
              "sourceMap": true,
              "outDir": "./dist"
            },
            "include": ["src/**/*"],
            "exclude": ["node_modules", "dist"]
          }
        },
        {
          "path": ".gitignore",
          "description": "Git ignore patterns",
          "content": ["node_modules", "dist", "*.log", ".DS_Store"]
        },
        {
          "path": "README.md",
          "description": "Project documentation",
          "sections": ["Introduction", "Features", "Architecture", "Installation", "Usage", "Examples", "Testing", "Contributing"]
        }
      ],
      "dependencies": []
    }
  ],
  "languageFeatures": {
    "variables": {
      "types": ["int", "char", "float"],
      "module": "memory-vm"
    },
    "arithmetic": {
      "operators": ["+", "-", "*", "/", "%"],
      "module": "arithmetic-vm"
    },
    "comparisons": {
      "operators": ["<", ">", "<=", ">=", "==", "!="],
      "module": "comparison-vm"
    },
    "controlFlow": {
      "constructs": ["if", "else", "else-if", "while", "for"],
      "module": "controlflow-vm"
    },
    "functions": {
      "features": ["parameters", "return values", "recursion", "call stack"],
      "module": "function-vm"
    },
    "arrays": {
      "features": ["declaration", "indexing", "multi-dimensional"],
      "module": "memory-vm"
    },
    "pointers": {
      "operators": ["& (address-of)", "* (dereference)"],
      "module": "memory-vm"
    },
    "io": {
      "functions": ["printf", "scanf"],
      "module": "io-vm"
    },
    "strings": {
      "features": ["literals", "format strings"],
      "module": "io-vm"
    },
    "types": {
      "features": ["type checking", "implicit casting", "explicit casting"],
      "module": "type-vm"
    }
  },
  "implementationOrder": [
    "core-interfaces",
    "lexer",
    "parser",
    "microvm-registry",
    "arithmetic-vm",
    "comparison-vm",
    "type-vm",
    "memory-vm",
    "io-vm",
    "controlflow-vm",
    "function-vm",
    "compiler",
    "cli",
    "config",
    "tests"
  ],
  "testStrategy": {
    "unitTests": [
      "lexer tokenization",
      "parser AST generation",
      "each VM module independently"
    ],
    "integrationTests": [
      "compile and run simple programs",
      "complex multi-feature programs",
      "error handling and edge cases"
    ],
    "fixtures": [
      "hello.c",
      "factorial.c",
      "fibonacci.c",
      "arrays.c",
      "pointers.c",
      "loops.c",
      "functions.c",
      "io.c",
      "complex.c"
    ]
  },
  "cliInterface": {
    "commands": {
      "compile": "Compile a .c file to AST",
      "run": "Compile and run a .c file",
      "ast": "Output AST as JSON",
      "tokens": "Output tokens for debugging"
    },
    "options": {
      "--output, -o": "Output file",
      "--ast": "Show AST output",
      "--tokens": "Show token output",
      "--verbose, -v": "Verbose output",
      "--help, -h": "Show help",
      "--version, -V": "Show version"
    }
  }
}