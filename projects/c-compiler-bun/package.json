{
  "name": "c-compiler-bun",
  "version": "0.1.0",
  "description": "A C compiler built with TypeScript and Bun using micro-VM architecture",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cc-bun": "dist/cli.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node",
    "dev": "bun --watch src/cli.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "compiler",
    "c",
    "typescript",
    "bun",
    "vm"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}