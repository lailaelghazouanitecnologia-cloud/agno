{
  "project": "c-compiler-bun",
  "description": "A C compiler built with TypeScript and Bun using micro-VM architecture",
  "features": [
    "variables (int, char, float)",
    "arithmetic (+,-,*,/,%)",
    "comparisons (<,>,<=,>=,==,!=)",
    "if/else/else-if",
    "while/for loops",
    "functions with parameters and return values",
    "arrays",
    "pointers (basic: &, *)",
    "printf/scanf",
    "string literals"
  ],
  "architecture": {
    "lexer": "Tokenizer for C tokens",
    "parser": "Recursive descent, builds AST",
    "microvm-registry": "Central dispatcher for VMs",
    "arithmetic-vm": "Handles +,-,*,/,% operations",
    "comparison-vm": "Handles relational and equality ops",
    "control-flow-vm": "Handles if/else, while, for",
    "function-vm": "Handles function definitions, calls, returns, call stack",
    "memory-vm": "Handles variables, arrays, pointers, scoping with stack frames",
    "io-vm": "Handles printf/scanf",
    "type-vm": "Handles type checking and casting",
    "compiler": "Main orchestrator",
    "cli": "Command-line interface"
  },
  "structure": {
    "root": [
      "package.json",
      "tsconfig.json",
      "plan.json",
      "verify-scaffold.ts"
    ],
    "src": [
      "interfaces.ts",
      "types.ts",
      "lexer.ts",
      "parser.ts",
      "microvm-registry.ts",
      "arithmetic-vm.ts",
      "comparison-vm.ts",
      "control-flow-vm.ts",
      "function-vm.ts",
      "memory-vm.ts",
      "io-vm.ts",
      "type-vm.ts",
      "compiler.ts",
      "cli.ts",
      "index.ts"
    ],
    "src/core": [
      "interfaces.ts",
      "types.ts",
      "index.ts"
    ],
    "src/lexer": [
      "lexer.ts",
      "index.ts"
    ],
    "src/parser": [
      "parser.ts",
      "index.ts"
    ],
    "src/vm": [
      "MicroVM.ts",
      "base-vm.ts",
      "registry.ts",
      "arithmetic-vm.ts",
      "comparison-vm.ts",
      "control-flow-vm.ts",
      "function-vm.ts",
      "memory-vm.ts",
      "io-vm.ts",
      "type-vm.ts",
      "index.ts"
    ],
    "src/vms": [
      "arithmetic-vm.ts",
      "comparison-vm.ts",
      "control-flow-vm.ts",
      "function-vm.ts",
      "io-vm.ts",
      "memory-vm.ts",
      "type-vm.ts"
    ],
    "tests": [
      "lexer.test.ts",
      "parser.test.ts",
      "vm.test.ts",
      "compiler.test.ts",
      "integration.test.ts",
      "test-utils.ts",
      "index.test.ts"
    ],
    "test": [
      "vm.test.ts",
      "integration.test.ts",
      "examples.ts"
    ],
    "examples": [
      "hello.c",
      "variables.c",
      "arithmetic.c",
      "comparisons.c",
      "ifelse.c",
      "while.c",
      "for.c",
      "loops.c",
      "function.c",
      "functions.c",
      "factorial.c",
      "fibonacci.c",
      "recursion.c",
      "arrays.c",
      "multi-array.c",
      "pointers.c",
      "io.c",
      "control-flow.c"
    ]
  }
}